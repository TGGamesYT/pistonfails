{
  "schemaVersion": 1,
  "id": "pistonfails",
  "version": "${version}",
  "name": "Piston Fails",
  "description": "Shows what blocks a piston failed to move",
  "authors": ["TGdoesCode"],
  "contact": {},
  "license": "MIT",
  "icon": "assets/pistonfails/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "dev.tggamesyt.pistonfails.client.PistonfailsDataGenerator"
    ],
    "client": [
      "dev.tggamesyt.pistonfails.client.PistonfailsClient"
    ],
    "main": [
      "dev.tggamesyt.pistonfails.Pistonfails"
    ]
  },
  "mixins": [
    "pistonfails.mixins.json",
    {
      "config": "pistonfails.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
